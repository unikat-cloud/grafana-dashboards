{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki Data Source",
      "description": "",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "uid": "alloy-loki-journal-docker",
  "title": "Alloy Loki Journal + Docker",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "timezone": "browser",
  "tags": [
    "loki",
    "alloy",
    "journal",
    "docker",
    "protokolle"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ],
    "time_options": [
      "5m",
      "15m",
      "1h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "DS_LOKI",
        "label": "Loki",
        "description": "Loki-Datenquelle f\u00fcr Log-Abfragen",
        "type": "datasource",
        "query": "loki",
        "current": {
          "selected": false,
          "text": "Loki",
          "value": "Loki"
        },
        "hide": 0,
        "refresh": 1,
        "skipUrlSync": false,
        "options": [],
        "multi": false,
        "includeAll": false
      },
      {
        "name": "host",
        "type": "query",
        "label": "Host",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "query": "label_values(host)",
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "container",
        "type": "query",
        "label": "Container",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "query": "label_values(container)",
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "search",
        "type": "textbox",
        "label": "Suche in Logs",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Log-Volumen",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "VM-Log-Volumen (Journal)",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host) (count_over_time({host=~\"$host\", source=\"journal\"}[$__interval]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Docker-Log-Volumen",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (count_over_time({host=~\"$host\", source=\"docker\", container=~\"$container\"}[$__interval]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "id": 3
    },
    {
      "type": "row",
      "title": "Fehler-Volumen",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "VM-Fehler-Volumen (Journal)",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host) (count_over_time({host=~\"$host\", source=\"journal\"} |= \"error\" [$__interval]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Docker-Fehler-Volumen",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (count_over_time({host=~\"$host\", source=\"docker\", container=~\"$container\"} |= \"error\" [$__interval]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "id": 6
    },
    {
      "type": "row",
      "title": "Live-Logs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 7
    },
    {
      "type": "logs",
      "title": "VM-Logs (Journal)",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{host=~\"$host\", source=\"journal\"} |= \"$search\""
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "id": 8
    },
    {
      "type": "logs",
      "title": "Docker-Logs",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{host=~\"$host\", source=\"docker\", container=~\"$container\"} |= \"$search\""
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "id": 9
    }
  ],
  "description": "Alloy + Loki: Log-Volumen und Live-Logs aus System-Journal und Docker-Containern. Filter nach Host und Container.",
  "editable": true,
  "graphTooltip": 1,
  "weekStart": null,
  "fiscalYearStartMonth": null,
  "style": "dark",
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.0.0"
    },
    {
      "type": "panel",
      "id": "logs",
      "name": "logs",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "row",
      "name": "row",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "timeseries",
      "version": "1.0.0"
    },
    {
      "type": "datasource",
      "id": "loki",
      "name": "Loki",
      "version": "5.0.0"
    }
  ]
}